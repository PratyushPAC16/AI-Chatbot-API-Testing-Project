# ─────────────────────────────────────────────────────────────
# AI Chatbot API Testing Framework — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file is listed in .gitignore and is NEVER committed.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────

# OpenAI API Key (required only for real API tests)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mock server port (optional — defaults to 5001 if not set)
# MOCK_SERVER_PORT=5001
